<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.marcjimenez.session-audit</string>

  <!-- No shell: a `cd __REPO__ && claude` string breaks silently on a path with a space, and plutil
       still passes because the XML is fine. WorkingDirectory and an absolute binary avoid both. -->
  <key>ProgramArguments</key>
  <array>
    <string>__CLAUDE__</string>
    <string>-p</string>
    <string>/marcjimenez:session-audit</string>
    <string>--permission-mode</string>
    <string>acceptEdits</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>

  <!-- Weekdays, staggered off the hour. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
  </array>

  <key>StandardOutPath</key><string>__LOGDIR__/session-audit.log</string>
  <key>StandardErrorPath</key><string>__LOGDIR__/session-audit.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
